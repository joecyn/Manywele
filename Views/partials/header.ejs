<nav class="navbar navbar-expand-lg navbar-light">
  <div class="container">
    <a class="navbar-brand d-flex align-items-center" href="/">
     <img src="/images/IMG-20230104-WA0002.jpg" alt="Deni Debt" width="46" height="46">
      <!-- <span class="ms-2">Deni Debt</span> -->
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarSupportedContent">
      <ul class="navbar-nav me-auto mb-2 mb-lg-0">
        <li class="nav-item">
          <a class="nav-link active" aria-current="page" href="/">Home</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/Add"><i class="fa-solid fa-circle-plus"></i> New Debt</a>
        </li>
        <% if (user) { %>
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle notification-nav-link" href="#" id="notificationsDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
              <i class="fa-solid fa-bell"></i> Notifications
              <% if (typeof todayFollowUps !== 'undefined' && todayFollowUps.length > 0) { %>
                <span class="notification-count"><%= todayFollowUps.length %></span>
              <% } %>
            </a>
            <ul class="dropdown-menu dropdown-menu-end notification-menu" aria-labelledby="notificationsDropdown">
              <li><h6 class="dropdown-header">Follow-ups due today</h6></li>
              <% if (typeof todayFollowUps !== 'undefined' && todayFollowUps.length > 0) { %>
                <% todayFollowUps.forEach(function(followUp) { %>
                  <li>
                    <a class="dropdown-item notification-dropdown-item" href="/Details/<%= followUp.customerId %>">
                      <strong><%= followUp.customerName.toUpperCase() %></strong>
                      <span><%= followUp.phone %></span>
                      <small>Due <%= followUp.dueDate %></small>
                    </a>
                  </li>
                <% }) %>
              <% } else { %>
                <li><span class="dropdown-item-text text-muted">No follow-ups due today.</span></li>
              <% } %>
            </ul>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/SignOut"><i class="fa-solid fa-right-from-bracket"></i> Sign Out</a>
          </li>
        <% } else { %>
          <li class="nav-item">
            <a class="nav-link" href="/Login"><i class="fa-solid fa-right-to-bracket"></i> Sign In</a>
          </li>
        <% } %>
      </ul>
      <% if (showSearch) { %>
      <form class="d-flex search-form" role="search" action="/" method="GET">
        <input name="search" class="form-control me-2" type="search" placeholder="Search by name" aria-label="Search by name" value="<%= typeof searchTerm !== 'undefined' ? searchTerm : '' %>" required />
        <button class="btn btn-primary btn-icon" type="submit"><i class="fa-solid fa-magnifying-glass"></i> Search</button>
      </form>
      <% } %>
    </div>
  </div>
</nav>
