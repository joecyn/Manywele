<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head'); %>
</head>
<body>
  <main class="auth-page">
    <form method="post" action="/Register" class="auth-card">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <div class="auth-logo">
       <img src="/images/IMG-20230104-WA0002.jpg" alt="Deni Debt" width="46" height="46">
      </div>
      <h1 class="auth-title">Register</h1>
      <% if (Message !==" ") { %>
        <div class="alert alert-danger"><%= Message %></div>
      <% } %>
      <div>
        <input type="text" name="name" class="form-control" required maxlength="20" minlength="6" placeholder="Name">
      </div>
      <div>
        <input type="email" name="email" class="form-control" required placeholder="Email">
      </div>
      <div>
        <input type="password" name="password" class="form-control" maxlength="20" minlength="8" required placeholder="Password">
      </div>
      <div>
        <input type="password" name="confirmPassword" id="confirmPassword" class="form-control" maxlength="20" minlength="8" required placeholder="Confirm Password">
        <div id="password-match-error" style="color:#c00;display:none;font-size:0.9em;margin-top:6px;">Passwords do not match</div>
      </div>
      <div>
        <button class="btn btn-primary w-100" type="submit">Register</button>
      </div>
      <div class="link">
        Please <a href="/Login">login</a> if you already have an account.
      </div>
    </form>
  </main>
  <script>
    (function(){
      const form = document.querySelector('.auth-card');
      if (!form) return;
      const pwd = form.querySelector('input[name="password"]');
      const confirm = form.querySelector('input[name="confirmPassword"]');
      const err = document.getElementById('password-match-error');
      form.addEventListener('submit', function(e){
        if (pwd && confirm && pwd.value !== confirm.value) {
          e.preventDefault();
          if (err) err.style.display = 'block';
          confirm.focus();
        }
      });
      if (confirm) {
        confirm.addEventListener('input', function(){
          if (err) err.style.display = (pwd.value === confirm.value) ? 'none' : 'block';
        });
      }
    })();
  </script>
</body>
</html>
