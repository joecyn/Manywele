<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.2.0/css/all.min.css" integrity="sha512-xh6O/CkQoPOWDdYTDqeRdPCVd1SpvCA9XXcUnZS2FmJNp1coAFzvtCN9BmamE+4aHK8yyUHUSCcJHgXloTyT2A==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-Zenh87qX5JnK2Jl0vWa8Ck2rdkQ2Bzep5IDxbcnCeuOxjzrPF/et3URy9Bv1WTRi" crossorigin="anonymous">
    <title>Home</title>
    <style>
      body{
        width: 980px;
        margin: auto;
      }
      .update{
        padding-right:10px;
      }
      .navbar{
        display: flex;
        justify-content: space-between;
      }
      .items{
        display: flex;
      }
       li{
        list-style: none;
      }
      li a{
        text-decoration: none;
        margin-right:20px;
      }
    </style>
</head>

<body>
  <nav>
    <ul class="navbar">
      <div class="logo">
        <li>logo</li>
      </div>
      <div class="items">
        <li><a href="http:/Home">HOME</a></li>
        <li><a href="http:/Add">NEW DEBT</a></li>
        <li><a href="http:/Search">SEARCH</a></li>
      </div>
    </ul>
  </nav>
    <table class="table table-hover table-dark">
        <thead>
          <tr>
            
            <th scope="col">NAME</th>
            <th scope="col">PHONE NUMBER</th>
            <th scope="col">DEBT AMOUNT</th>
            <th scope="col">DEBT REMAINING</th>
            
            
            <th></th>
          </tr>
        </thead>
        <tbody>
          
          <%customers.forEach(customer => {%>
            <tr>
              
              <td><%=customer.name%></td>
              <td><%=customer.phone%></td>
              <%customer.debt.forEach((debt)=>{%>
                <td><%=debt.amount%></td>
                <td><%=debt.amountRem%></td>
                

              <%})%>
              
              
              
              
              <td>
                <a href="/Details/<%=customer._id%>" class="update" >DETAILS</a>
                <a href="/Payment/<%=customer._id%>" class="update" >MAKE PAYMENT</a>
                <a href="/Update/<%=customer._id%>" class="update" ><i class="fa-solid fa-pencil"></i></a>
                <a href="/Delete/<%=customer._id%>"><i class="fa-solid fa-trash-can "></i></a>
              </td>
            </tr>  
            <%})%>
            
          
        </tbody>
      </table>

    
</body>
</html>
