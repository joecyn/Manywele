<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head'); %>
</head>
<body>
  <header>
    <%- include('../partials/header'); %>
  </header>
  <div class="container">
    <% if (message.success) { %>
      <div class="alert alert-success" role="alert">
        <%= message.success %>
      </div>
    <% } %>
    <div class="table-responsive">
      <table class="table table-hover table-dark">
        <thead>
          <tr>
            <th scope="col">NAME</th>
            <th scope="col">PHONE NUMBER</th>
            <th scope="col">DEBT AMOUNT</th>
            <th scope="col">DEBT REMAINING</th>
            <th scope="col">ACTIONS</th>
          </tr>
        </thead>
        <tbody>
          <% if (!customers) { %>
            <tr><td colspan="5"><h4>No Records Available</h4></td></tr>
          <% } else { %>
            <% customers.forEach(customer => { %>
              <tr>
                <td><%= customer.name.toUpperCase().slice(0, 10) %>...</td>
                <td><%= customer.phone %></td>
                <% customer.debt.forEach((debt) => { %>
                  <td><%= debt.amount %></td>
                  <td><%= debt.amountRem %></td>
                <% }) %>
                <td>
                  <a href="/Details/<%= customer._id %>" class="btn btn-sm btn-outline-light">DETAILS</a>
                  <a href="/Payment/<%= customer._id %>" class="btn btn-sm btn-outline-light">PAY</a>
                  <a href="/Update/<%= customer._id %>"><i class="fa-solid fa-pencil"></i></a>
                  <a href="/Delete/<%= customer._id %>"><i class="fa-solid fa-trash-can"></i></a>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
    <button type="button" class="btn btn-dark"><b>TOTAL DEBT OWED: Ksh <%= totalOwed %></b></button>
    <br><br>
    <button type="button" class="btn btn-dark"><b>TOTAL CUSTOMERS: <%= customers.length %></b></button>
  </div>
</body>
</html>