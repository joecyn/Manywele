<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head'); %>
</head>
<body>
  <main class="auth-page">
    <form method="POST" action="/Login" class="auth-card">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <div class="auth-logo">
       <img src="/images/IMG-20230104-WA0002.jpg" alt="Deni Debt" width="46" height="46">
      </div>
      <h1 class="auth-title">Login</h1>
      <% if (Message) { %>
        <p class="alert alert-danger mb-0 text-center"><%= Message %></p>
      <% } %>
      <div class="mb-3">
        <input type="email" name="email" class="form-control" placeholder="Email" required>
      </div>
      <div class="mb-3">
        <input type="password" name="password" class="form-control" placeholder="Password" required>
      </div>
      <div>
        <button class="btn btn-primary w-100" type="submit">Login</button>
      </div>
      <div class="link text-center">
        Please <a href="/Register">register</a> if you don't have an account.
      </div>
    </form>
  </main>
</body>
</html>
