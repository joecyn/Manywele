<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head'); %>
</head>
<body>
 <header>
  <%- include('../partials/header'); %>
 </header>
    
      
      <%if(customer.length>0){%>
      <table class="table table-hover table-dark">
        <thead>
          <tr>
            
            <th scope="col">NAME</th>
            <th scope="col">PHONE NUMBER</th>
            <th scope="col">DEBT AMOUNT</th>
            <th scope="col">DEBT REMAINING</th>
            
            
            <th></th>
          </tr>
        </thead>
        <tbody>
          
          
            <tr>
              
            <td><%=customer[0].name.toUpperCase()%></td>
            <td><%=customer[0].phone%></td>
            <%customer[0].debt.forEach((debt)=>{%>
                <td><%=debt.amount%></td>
                <td><%=debt.amountRem%></td>
                

              <%})%>
                 
              <td>
                <a href="/Details/<%=customer[0]._id%>"  >DETAILS</a>
                <a href="/Payment/<%=customer[0]._id%>"  >MAKE PAYMENT</a>
                <a href="/Update/<%=customer[0]._id%>"  ><i class="fa-solid fa-pencil"></i></a>
                <a href="/Delete/<%=customer[0]._id%>"><i class="fa-solid fa-trash-can "></i></a>
              </td>
            </tr>  
           
            
          
        </tbody>
      </table>
      <%}else{%>
        <table class="table table-hover table-dark">
          <thead>
            <tr>
              
              <th scope="col">NAME</th>
              <th scope="col">PHONE NUMBER</th>
              <th scope="col">DEBT AMOUNT</th>
              <th scope="col">DEBT REMAINING</th>
              
              
              <th></th>
            </tr>
          </thead>
          <tbody>
          </tbody>
        </table>
       <%if(message){%>
          <h4><%=message%></h4>
        <%}%>

        <%}%>

</body>
</html>