<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head'); %>
</head>
<body>
  <header>
    <%- include('../partials/header'); %>
  </header>
  <form method="POST" action="/Add" class="form update">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <h4>NEW DEBT</h4>
    <div>
      <input type="text" name="name" class="form-control" placeholder="NAME" required>
    </div>
    <div>
      <input type="text" name="phone" class="form-control" placeholder="PHONE" required>
    </div>
    <div>
      <input type="number" name="amount" class="form-control" placeholder="AMOUNT" min="0" required>
    </div>
    <div>
      <input type="number" name="amountPaid" class="form-control" placeholder="AMOUNT PAID" min="0">
    </div>
    <div>
      <textarea name="items" class="form-control" rows="5" placeholder="Items bought" required></textarea>
    </div>
    <div>
      <button type="submit" class="btn btn-primary">ADD</button>
    </div>
  </form>
</body>
</html>