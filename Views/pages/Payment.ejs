<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head'); %>
</head>
<body>
  <header>
    <%- include('../partials/header'); %>
  </header>
  <form action="/payment/<%= customer._id %>" class="payment update" method="POST">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <h4>MAKE <b><%= customer.name.toUpperCase() %>'s</b> PAYMENT</h4>
    <div class="debt-info">
      <% customer.debt.forEach((debt) => { %>
        <input type="text" class="form-control-plaintext" value="DEBT AMOUNT: <%= debt.amount %>" readonly>
        <input type="text" class="form-control-plaintext" value="DEBT REMAINING: <%= debt.amountRem %>" readonly>
        <input type="hidden" name="amountRem" value="<%= debt.amountRem %>">
      <% }) %>
    </div>
    <div>
      <input type="hidden" name="name" value="<%= customer.name %>">
    </div>
    <div>
      <input type="number" name="amountPaid" class="form-control" placeholder="AMOUNT BEING PAID" min="0" required>
    </div>
    <div>
      <button type="submit" class="btn btn-primary">PAY</button>
    </div>
  </form>
</body>
</html>