<body>
    <header>
        <%- include('../partials/header'); %>
       </header>
    
   <form action="/Payment/<%=customer._id%>" class="payment" method="post">
    <h4></h4>
    <h4>
        <button type="button" class="btn btn-dark">
            MAKE <b><%=customer.name.toUpperCase()%>'s </b> PAYMENT
        </button>
    </h4>
        <div>
        <%customer.debt.forEach((debt)=>{%>
             <input type="text" value="DEBT AMOUNT:<%=debt.amount%>" disabled/><br>
             <input type="text" value="DEBT REMAINING:<%=debt.amountRem%>" disabled/>
             
             <input type="text"  name="amountRem" value="<%=debt.amountRem%>" hidden>
            
        <%})%>
        </div>
             <div>
                <input class="input" type="text" name="name"  hidden value="<%=customer.name%>">
            </div>
        
       
    <div>
        <input type="text"  name="amountPaid" placeholder="AMOUNT BEING PAID">
    </div>
    <div>
        <button type="submit" class="btn btn-dark">PAY</button>
        <!-- <button class="" class="btn btn-dark" type="submit">PAY</ADDress></button> -->
    </div>
   </form>
</body>
</html>
