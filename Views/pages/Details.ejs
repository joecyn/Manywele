<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head'); %>
</head>
<body>
  <header>
    <%- include('../partials/header'); %>
  </header>
  <div class="container">
    <% if (message.success) { %>
      <div class="alert alert-success" role="alert">
        <%= message.success %>
      </div>
    <% } %>
    <section>
      <h4><%= customer.name.toUpperCase() %>'s DEBT DETAILS</h4>
      <hr>
      <div class="debt-info">
        <p><b>NAME:</b> <%= customer.name.toUpperCase() %></p>
        <p><b>PHONE:</b> <%= customer.phone %></p>
        <% customer.debt.forEach((debt) => { %>
          <p><b>DEBT AMOUNT:</b> KSH <%= debt.amount %></p>
          <p>
            <b>DEBT REMAINING:</b>
            <% if (debt.amountRem <= 0) { %>
              <span class="status-badge status-paid">Fully Paid</span>
            <% } else { %>
              KSH <%= debt.amountRem %>
            <% } %>
          </p>
          <p><b>DATE TAKEN:</b> <%= debt.date.getDate() %>/<%= debt.date.getMonth() + 1 %>/<%= debt.date.getFullYear() %></p>
        <% }) %>
      </div>
      <div><b>PAYMENTS MADE</b></div>
      <div class="table-responsive">
        <table class="table table-hover table-dark">
          <thead>
            <tr>
              <th scope="col">AMOUNT PAID</th>
              <th scope="col">DATE PAID</th>
            </tr>
          </thead>
          <tbody>
            <% customer.payment.forEach((pay) => { %>
              <tr>
                <td>KSH <%= pay.amountPaid %></td>
                <td><%= pay.datePaid.getDate() %>/<%= pay.datePaid.getMonth() + 1 %>/<%= pay.datePaid.getFullYear() %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <div><b>TOTAL PAYMENT:</b> KSH <%= totalPayment %></div>
      <br>
      <div><b>ITEMS PURCHASED:</b></div>
      <div>
        <p class="textarea"><%= customer.debt[0].items.toUpperCase() %></p>
      </div>
      <a href="/Update/<%= customer._id %>" class="btn btn-primary">
        EDIT <i class="fa-solid fa-pencil"></i>
      </a>
      <a href="/Delete/<%= customer._id %>" class="btn btn-danger ms-2" onclick="return confirm('Warning: This will permanently delete this record. This action cannot be undone. Do you want to continue?');">
        DELETE <i class="fa-solid fa-trash-can"></i>
      </a>
    </section>
  </div>
</body>
</html>